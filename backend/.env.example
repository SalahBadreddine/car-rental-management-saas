# Environment variable examples for car-rental-management-saas backend
# Copy this file to `.env` and fill in real values.

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS and email redirects)
# Local: http://localhost:5173
# Production: https://your-frontend.netlify.app
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:5173/verify-email
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Supabase configuration
# Base URL of your Supabase project (https://xxxxx.supabase.co)
SUPABASE_URL=your-supabase-url
# Service Role Key (DO NOT expose publicly; keep out of client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (Optional) Public anon key if needed for server-side operations
SUPABASE_ANON_KEY=your-anon-key

# Gmail SMTP for email notifications
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Supabase Storage (for image uploads)
SUPABASE_STORAGE_BUCKET=images
